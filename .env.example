# ==============================================================================
# NASA Space Apps Challenge 2026 — MODIS + VIIRS Hotspot Harmonization
# Environment Configuration
# ==============================================================================

# Data Source Switch:
# Set VITE_USE_MOCK=true to use the deterministic seeded mock data generator.
# Set VITE_USE_MOCK=false to fetch real harmonized files from VITE_DATA_BASE_URL.
VITE_USE_MOCK=true

# Base URL where harmonized data files live (local folder under public/ or remote API):
# Expected endpoints under VITE_DATA_BASE_URL:
#   - /daily_summary.json
#   - /grid_cells.geojson
#   - /recent_points.json
#   - /seasonality.json
#   - /anomalies.json
#   - /risk_periods.json
#   - /validation.json
#   - /region_meta.json
#   - /conf_mapping.json
VITE_DATA_BASE_URL=/sample-data

# MapLibre GL Dark Basemap Style URL & optional API Key:
VITE_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_KEY=

# Project Branding Overrides (Optional):
VITE_PROJECT_NAME=FIRMS Harmonizer
VITE_TAGLINE=Unified MODIS & VIIRS Active-Fire Intelligence
